{
    "name": "fullstack-from-principles",
    "private": true,
    "workspaces": [
      "client",
      "server"
    ],
    "scripts": {
      "lint": "npm run lint -w client && npm run lint -w server",
      "build": "npm run build -w client && npm run build -w server",
      "dev:client": "npm run dev -w client",
      "build:client": "npm run build -w client",
      "test:client": "npm run test -w client -- --run",
      "lint:client": "npm run lint -w client",
      "dev:server": "npm run dev -w server",
      "build:server": "npm run build -w server",
      "test:server": "npm run test -w server -- --run",
      "lint:server": "npm run lint -w server"
    }
}